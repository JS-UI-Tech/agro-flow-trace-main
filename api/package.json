{
  "name": "agrotrace-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "auth:migrate": "bunx @better-auth/cli@latest migrate -y --config src/auth.ts",
    "auth:generate": "bunx @better-auth/cli@latest generate -y --config src/auth.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.2.8",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.3"
  }
}
